#!/sbin/openrc-run

command="/usr/local/we1ssboard/we1ssboard"
command_background=true
pidfile="/run/we1ssboard.pid"
description="We1ssBoard Service"
procname="we1ssboard"
depend() {
    need net
}
start_pre(){
    cd /usr/local/we1ssboard
}
reload() {
  ebegin "Reloading ${RC_SVCNAME}"
  kill -USR1 $(cat $pidfile)
  eend $?
}